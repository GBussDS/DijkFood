# Copie este arquivo para terraform.tfvars e preencha os valores.
# NÃO versione terraform.tfvars — ele contém segredos.

aws_region  = "us-east-1"
aws_profile = "default"     # perfil do AWS Academy no ~/.aws/credentials
project     = "dijkfood"
iam_role_name = "LabRole"

# Credenciais da conta pessoal para o Amazon Bedrock
# Crie um usuário IAM com AmazonBedrockFullAccess e gere Access Keys
bedrock_profile           = "bedrock"
bedrock_access_key_id     = "AKIA..."
bedrock_secret_access_key = "..."
bedrock_session_token     = ""
bedrock_model_id          = "amazon.nova-micro-v1:0"

# Banco de dados
db_instance_class = "db.t3.micro"
db_name           = "dijkfood"
db_username       = "dijkfood"
db_password       = "TROQUE_ESTA_SENHA"
